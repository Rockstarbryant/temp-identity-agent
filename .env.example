# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.

# =============================================================================
# Django core
# =============================================================================
DJANGO_SECRET_KEY=change-me-to-a-long-random-50-plus-char-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com,localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.production

# =============================================================================
# Database (Neon recommended for Render)
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# =============================================================================
# Redis / Celery (Upstash recommended)
# =============================================================================
REDIS_URL=rediss://default:token@your-upstash-host:6379/0?ssl_cert_reqs=required

# =============================================================================
# CORS (your Vercel frontend origin)
# =============================================================================
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# =============================================================================
# AI providers
# =============================================================================
# fallback = try Agent Router first, then Groq on rate-limit / 5xx / network error
AI_PROVIDER=fallback

# Primary (Agent Router / OpenRouter-compatible)
AGENT_ROUTER_API_KEY=
AGENT_ROUTER_BASE_URL=https://agentrouter.org/v1
AGENT_ROUTER_MODEL=gpt-5.6-sol

# Fallback (Groq) — get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

MAX_AGENT_STEPS=30
MAX_JOB_DURATION_SECONDS=300

# =============================================================================
# Email provider (mail.tm by default — no key required)
# =============================================================================
EMAIL_PROVIDER=mailtm
EMAIL_API_KEY=
EMAIL_API_BASE_URL=https://api.mail.tm

# =============================================================================
# Credential encryption (REQUIRED)
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# =============================================================================
CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# Retention / abuse prevention
# =============================================================================
TEMP_ACCOUNT_RETENTION_DAYS=7
MAX_CONCURRENT_JOBS=3
MAX_JOBS_PER_USER_PER_DAY=20

IDENTITY_PASSWORD_LENGTH=20
IDENTITY_PASSWORD_MIN_UPPER=2
IDENTITY_PASSWORD_MIN_LOWER=2
IDENTITY_PASSWORD_MIN_DIGITS=2
IDENTITY_PASSWORD_MIN_SYMBOLS=2

# =============================================================================
# Observability (optional)
# =============================================================================
SENTRY_DSN=

DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False
